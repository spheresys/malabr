+"""What re-reading a dropped page costs: first-token time with the page minus
+without it, at the same depth, on an otherwise idle engine.
+"""
+import argparse, json, os, statistics, sys, time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from harness import Fixture, force_turn  # noqa: E402
+from malabr_service import engine as eng  # noqa: E402
+
+KEY = ("a" * 32, 1, "https://a.test")
+
+
+def text_of(f, n):
+    t = "alpha"
+    while len(f._tokenize(t, parse_special=False)) < n:
+        t += " alpha"
+    return t
+
+
+def ttft(e, ob):
+    t0 = time.perf_counter(); first = None
+    while True:
+        e._step()
+        while not ob.empty():
+            kind, _ = ob.get_nowait()
+            if kind == eng.FRAME_TOKEN and first is None:
+                first = time.perf_counter() - t0
+            elif kind in (eng.FRAME_COMPLETE, eng.FRAME_ERROR):
+                return first, kind
+
+
+def trial(fix, shared, budget, depth, page, q):
+    _, e = fix.new_engine(shared_kv=shared, session_budget=budget)
+    s, _ = e.get_or_create(KEY, fix.formatter, eng.OutputCap([(0, 8)]))
+    filler = text_of(fix.formatter(), 450)
+    while s.pos < depth:
+        force_turn(e, s, filler, "ok")
+    ob = e.submit(KEY, q, page=page) if page else e.submit(KEY, q)
+    got = ttft(e, ob)
+    e.cancel(KEY, "done"); e._step()
+    return got
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=5)
+    ap.add_argument("--json")
+    a = ap.parse_args()
+    rows = []
+    for mode, budget, depths in (("partitioned", 2048, (0, 1000)), ("shared", 8192, (0, 1000, 4000))):
+        shared = mode == "shared"
+        fix = Fixture(n_seq_max=8, n_ctx=16384, n_threads=3, kv_unified=shared)
+        fix.use_measured_calibration(shared)
+        f = fix.formatter()
+        for tokens in (900, 3000) if shared else (900,):
+            page = ("h", text_of(f, tokens))
+            for d in depths:
+                w = [trial(fix, shared, budget, d, page, "Say hi.")[0] for _ in range(a.n)]
+                wo = [trial(fix, shared, budget, d, None, "Say hi.")[0] for _ in range(a.n)]
+                m, n = statistics.median(w), statistics.median(wo)
+                rows.append({"mode": mode, "page": tokens, "depth": d, "with": w, "without": wo,
+                             "extra_median": m - n})
