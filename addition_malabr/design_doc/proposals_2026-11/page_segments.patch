+        ask(e, k, "Say hi.")
+        anchor = s.turn_boundaries[0]
+        big = _text_of_tokens(fix, 500)
+        ask(e, k, big + " one")
+        frames = _ask_frames(e, k, big + " two")
+        record(96, "a turn may compact its own previous exchange to fit",
+               not any(f == eng.FRAME_ERROR for f, _ in frames)
+               and len(s.turn_boundaries) == 2 and s.turn_boundaries[0] is anchor
+               and s.formatter.verify_against_full(),
+               f"terminal {_terminal(frames)[:1]}, {len(s.turn_boundaries)} exchanges, pos {s.pos}")
+    finally:
+        fix.close()
