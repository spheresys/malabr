+#!/usr/bin/env python3
+"""Real browser: a page the server dropped is re-read with the next question.
+
+  1. first question: the page is attached
+  2. a long question fits only if the page is dropped; the panel is told
+  3. next question: the page is re-read, and the server holds it again
+"""
+import os, shutil, subprocess, sys, time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from nano_cdp import WS, http_json  # noqa: E402
+import test_panel_status as tps  # noqa: E402
+
+LOG = "/tmp/malabr_pagereread.log"
+PROFILE = "/tmp/malabr-pagereread-profile"
+tps.PROFILE = PROFILE
+# Partitioned, 2 slots of 2,048: the panel's largest page (about 1,000 tokens)
+# fits, and matters.
+ENV = {**tps.ENV, "MALABR_N_SEQ_MAX": "2", "MALABR_N_CTX": "4096", "MALABR_SHARED_KV": "0",
+       "MALABR_QUICK_CALIBRATION": "1", "MALABR_CALIBRATION_PATH": "/tmp/malabr_pagereread_cal.json"}
+PARAS = " ".join(f"Paragraph {i} is about the migration of birds across the northern sea, "
+                 f"their nesting grounds and the seasons they follow." for i in range(40))
+RESULTS = []
+
+
+def check(name, ok, detail=""):
+    RESULTS.append((name, ok))
+    print(f"  [{'PASS' if ok else 'FAIL'}] {name}" + (f"   {detail}" if detail else ""), flush=True)
+
+
+def main():
+    if tps.server_pids():
+        sys.exit(f"a MALABR server is already running ({tps.server_pids()}); stop it first")
+    shutil.rmtree(PROFILE, ignore_errors=True)
+    tps.serve()
+    log = open(LOG, "w")
+    env = {**os.environ, **ENV, "EXTENSION_DIR": os.path.abspath(tps.EXT),
+           "USER_DATA_DIR": PROFILE, "RUN_LOG": LOG + ".runs"}
+    chrome = tps.launch(log, env)
+    try:
+        ver = http_json(tps.CDP, "/json/version", timeout=60)
+        if not tps.socket_ready(240):
+            check("model server came up", False, f"see {LOG}")
+            return 1
+        b = WS(ver["webSocketDebuggerUrl"])
+        tid = b.call("Target.createTarget", {"url": tps.A})["targetId"]
+        time.sleep(2.0)
+        t = [x for x in http_json(tps.CDP) if x["id"] == tid][0]
+        ws = WS(t["webSocketDebuggerUrl"])
+        p = tps.Panel(ws)
+        ws.call("Runtime.evaluate", {"expression":
+                f"document.body.insertAdjacentHTML('beforeend', '<article><p>{PARAS}</p></article>')"})
+        if not p.wait_ready(60):
+            check("panel injected", False)
+            return 1
+        p.ask("Reply with the single word ALPHA.")
+        first = p.text()
+        check("1. first question attaches the page and is served",
+              "page attached" in first and "refused" not in first and "gate" not in first, first[:120])
+        p.ask("Reply with the single word BRAVO. " + "filler " * 900)
+        second = p.text()
+        check("2. the drop is reported in the panel", "dropped from the model's memory" in second)
+        p.ask("Reply with the single word CHARLIE.")
+        third = p.text()
+        check("3. the next question re-reads the page", "re-read" in third)
+        ok = sum(1 for _, o in RESULTS if o)
+        print(f"\n{ok}/{len(RESULTS)} passed   (log: {LOG})")
+        return 0 if ok == len(RESULTS) else 1
+    finally:
+        chrome.terminate()
+        try:
+            chrome.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            chrome.kill()
+        end = time.time() + 20
+        while tps.server_pids() and time.time() < end:
+            time.sleep(0.5)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
