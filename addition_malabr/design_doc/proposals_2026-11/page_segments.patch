+def t98_secret_in_a_page_stays_in_its_session_and_goes_with_the_page():
+    alloc, e = FIX.new_engine()
+    page = ("h1", f"A note on this page: {CANARY}")
+    ka, sa = _sess(e, FIX, 1)                       # positive control
+    own = ask(e, ka, LEAK_QUESTION, page=page)
+    kb, sb = _sess(e, FIX, 2, "https://b.test")     # another session
+    other = ask(e, kb, LEAK_QUESTION)
+    kc, sc = _sess(e, FIX, 3, "https://c.test")     # same page, then dropped
+    ask(e, kc, "Say hello.", page=page)
+    e.compact(sc, target=1)
+    alive = ask(e, kc, "What is 2 + 2?")            # or "gone" could mean "broken"
+    dropped = ask(e, kc, LEAK_QUESTION)
+    record(98, "a secret in a page reaches its holder, no other session, and goes with the page",
+           recalls_canary(own) and not recalls_canary(other) and not recalls_canary(dropped)
+           and "4" in alive,
+           f"holder {recalls_canary(own)}, other {recalls_canary(other)}, "
+           f"after drop {recalls_canary(dropped)}")
+
