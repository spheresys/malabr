+# ---------------------------------------------------------------------------
+# 94-99: a page is its own exchange, which compaction may drop
+# ---------------------------------------------------------------------------
+
+def _ask_frames(e, k, prompt, page=None):
+    return drive(e, e.submit(k, prompt, page=page) if page else e.submit(k, prompt))
+
+
+def t94_page_is_a_droppable_exchange_and_the_first_question_survives():
+    alloc, e = FIX.new_engine()
+    k, s = _sess(e, FIX, 1)
+    ask(e, k, "Say hello.", page=("h1", _text_of_tokens(FIX, 200)))
+    roles = [t.role for t in s.turn_boundaries]
+    held = e.page_in_context(k)
+    freed = e.compact(s, target=1)
+    after = [t.role for t in s.turn_boundaries]
+    ok = s.formatter.verify_against_full()
+    # Not just "no crash": a stray marker left at position 0 gave empty replies.
+    follow = ask(e, k, "Say goodbye.")
+    record(94, "a page is its own exchange; compaction drops it and keeps the first question",
+           roles == ["page", "exchange"] and held == "h1" and freed >= 200
+           and after == ["exchange"] and e.page_in_context(k) is None
+           and ok and "oodbye" in follow,
+           f"roles {roles} -> {after}, freed {freed}, page {held} -> "
+           f"{e.page_in_context(k)}, next reply {follow!r}")
+
+
+def t95_replaced_page_goes_first_current_page_last():
+    alloc, e = FIX.new_engine()
+    k, s = _sess(e, FIX, 1)
+    ask(e, k, "Say one.", page=("h1", _text_of_tokens(FIX, 60)))
+    ask(e, k, "Say two.")
+    ask(e, k, "Say three.", page=("h2", _text_of_tokens(FIX, 60, word=" beta")))
+    ask(e, k, "Say four.")
+    order = [(t.role, t.page_hash) for t in e._drop_order(s, True)]
+    want = [("page", "h1"), ("exchange", None), ("exchange", None), ("page", "h2")]
+    e.compact(s, target=1)
+    kept = e.page_in_context(k)
+    n_pages = sum(t.role == "page" for t in s.turn_boundaries)
+    record(95, "compaction drops a replaced page first, the current page last",
+           order == want and kept == "h2" and n_pages == 1
+           and s.formatter.verify_against_full(), f"order {order}; page in context {kept}")
+
+
+def t96_own_turn_may_drop_the_previous_exchange():
+    """Part 5: the new turn becomes the latest, so the previous exchange need not
+    survive it. Before, anchor + one large exchange could take nothing more."""
+    fix = Fixture(n_seq_max=2, n_ctx=2048, kv_unified=False)     # 1,024 cells each
+    try:
+        _, e = fix.new_engine(shared_kv=False)
